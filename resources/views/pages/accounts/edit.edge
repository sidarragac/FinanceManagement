@layout('layouts/main', { title: viewData.title })

  @slot('main')
    <div class="max-w-lg mx-auto">
      <div class="mb-6 flex items-center justify-between">
        <div>
          <h1 class="text-2xl font-bold text-gray-900">{{ viewData.title }}</h1>
          <p class="text-sm text-gray-500">Modifica los detalles de tu cuenta</p>
        </div>
        <a href="{{ route('accounts.index') }}" class="text-sm font-medium text-gray-600 hover:text-gray-900">
          &larr; Volver
        </a>
      </div>

      <div class="bg-white p-8 rounded-xl border border-gray-200 shadow-sm">
        <form action="{{ route('accounts.update', { id: viewData.account.id }) }}?_method=PATCH" method="POST" class="space-y-5">
          {{ csrfField() }}

          {{-- Nombre de la cuenta --}}
          <div>
            <label for="name" class="block text-sm font-medium text-gray-700 mb-1">Nombre de la Cuenta</label>
            <input
              type="text"
              id="name"
              name="name"
              value="{{ old('name') || viewData.account.name }}"
              required
              class="w-full px-4 py-2 border rounded-lg text-sm focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition {{ flashMessages.has('errors.name') ? 'border-red-500' : 'border-gray-300' }}"
            >
            @if(flashMessages.has('errors.name'))
              <p class="text-xs text-red-500 mt-1">{{ flashMessages.get('errors.name') }}</p>
            @endif
          </div>

          {{-- Tipo de cuenta --}}
          <div>
            <label for="type" class="block text-sm font-medium text-gray-700 mb-1">Tipo de Cuenta</label>
            <select
              id="type"
              name="type"
              required
              class="w-full px-4 py-2 border rounded-lg text-sm focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition bg-white {{ flashMessages.has('errors.type') ? 'border-red-500' : 'border-gray-300' }}"
            >
              @let(currentType = old('type') || viewData.account.type)
              <option value="bank" {{ currentType === 'bank' ? 'selected' : '' }}>Banco / Ahorros</option>
              <option value="cash" {{ currentType === 'cash' ? 'selected' : '' }}>Efectivo</option>
              <option value="credit_card" {{ currentType === 'credit_card' ? 'selected' : '' }}>Tarjeta de Crédito</option>
            </select>
            @if(flashMessages.has('errors.type'))
              <p class="text-xs text-red-500 mt-1">{{ flashMessages.get('errors.type') }}</p>
            @endif
          </div>

          {{-- Balance Inicial --}}
          <div>
            <label for="initialBalance" class="block text-sm font-medium text-gray-700 mb-1">Saldo Inicial ($)</label>
            <input
              type="number"
              step="0.01"
              min="0"
              id="initialBalance"
              name="initialBalance"
              value="{{ old('initialBalance') !== undefined ? old('initialBalance') : viewData.account.initialBalance }}"
              required
              class="w-full px-4 py-2 border rounded-lg text-sm focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition {{ flashMessages.has('errors.initialBalance') ? 'border-red-500' : 'border-gray-300' }}"
            >
            @if(flashMessages.has('errors.initialBalance'))
              <p class="text-xs text-red-500 mt-1">{{ flashMessages.get('errors.initialBalance') }}</p>
            @endif
          </div>

          <div class="flex items-center justify-end gap-3 pt-4 border-t border-gray-100">
            <a href="{{ route('accounts.index') }}" class="px-4 py-2 rounded-lg text-sm font-medium text-gray-700 hover:bg-gray-100 transition">
              Cancelar
            </a>
            <button
              type="submit"
              class="bg-indigo-600 text-white font-medium px-5 py-2 rounded-lg hover:bg-indigo-700 transition duration-150 shadow-sm text-sm"
            >
              Actualizar Cuenta
            </button>
          </div>
        </form>
      </div>
    </div>
  @end
