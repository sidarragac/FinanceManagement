@layout('layouts/main', { title: viewData.title })

  @slot('main')
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-8">
      <div>
        <h1 class="text-3xl font-extrabold text-gray-900 tracking-tight">{{ viewData.title }}</h1>
        <p class="text-sm text-gray-600 mt-1">
          Balance Total: <span class="font-bold text-gray-900">${{ Number(viewData.totalBalance).toFixed(2) }}</span>
        </p>
      </div>
      <a
        href="{{ route('accounts.create') }}"
        class="bg-indigo-600 text-white px-5 py-2.5 rounded-lg text-sm font-semibold shadow-sm hover:bg-indigo-700 transition duration-150 flex items-center gap-2"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
        </svg>
        Nueva Cuenta
      </a>
    </div>

    {{-- Grid de Cuentas --}}
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      @each(account in viewData.accounts)
        <div class="bg-white p-6 rounded-xl border border-gray-200 shadow-sm flex flex-col justify-between hover:border-gray-300 transition">
          <div>
            <div class="flex items-center justify-between mb-3">
              <span class="text-xs font-bold uppercase tracking-wider px-2.5 py-1 rounded-full bg-indigo-50 text-indigo-700 border border-indigo-100">
                {{ account.type }}
              </span>
            </div>
            <h2 class="text-xl font-bold text-gray-900 mb-1">{{ account.name }}</h2>
            <p class="text-3xl font-extrabold text-gray-800 tracking-tight mt-2">
              ${{ Number(account.initialBalance).toFixed(2) }}
            </p>
          </div>

          <div class="mt-6 pt-4 border-t border-gray-100 flex items-center justify-between text-sm">
            {{-- <a
              href="{{ route('accounts.show', { id: account.id }) }}"
              class="text-gray-500 hover:text-gray-900 font-medium"
            >
              Ver detalles
            </a> --}}

            <div class="flex items-center gap-3">
              <a
                href="{{ route('accounts.edit', { id: account.id }) }}"
                class="text-indigo-600 hover:text-indigo-900 font-medium"
              >
                Editar
              </a>

              <form action="{{ route('accounts.destroy', { id: account.id }) }}?_method=DELETE" method="POST" class="inline">
                {{ csrfField() }}
                <button
                  type="submit"
                  class="text-red-600 hover:text-red-800 font-medium"
                  onclick="return confirm('¿Estás seguro de eliminar la cuenta {{ account.name }}?')"
                >
                  Eliminar
                </button>
              </form>
            </div>
          </div>
        </div>
      @else
        <div class="col-span-full bg-white p-12 rounded-xl border border-gray-200 text-center">
          <svg class="w-12 h-12 text-gray-400 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a2 2 0 002-2V7a2 2 0 00-2-2H6a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
          </svg>
          <h3 class="text-lg font-bold text-gray-900 mb-1">Aún no tienes cuentas registradas</h3>
          <p class="text-sm text-gray-500 mb-6">Crea tu primera cuenta para empezar a monitorear tus saldos.</p>
          <a
            href="{{ route('accounts.create') }}"
            class="inline-flex items-center gap-2 bg-indigo-600 text-white px-5 py-2.5 rounded-lg text-sm font-semibold hover:bg-indigo-700 transition"
          >
            + Crear Mi Primera Cuenta
          </a>
        </div>
