@layout('layouts/main', { title: viewData.title })

  @slot('main')
    <div class="max-w-lg mx-auto">
      <div class="mb-6 flex items-center justify-between">
        <div>
          <h1 class="text-2xl font-bold text-gray-900">{{ viewData.title }}</h1>
          <p class="text-sm text-gray-500">Registra un movimiento en tus cuentas</p>
        </div>
        <a href="{{ route('transactions.index') }}" class="text-sm font-medium text-gray-600 hover:text-gray-900">
          &larr; Volver
        </a>
      </div>

      <div class="bg-white p-8 rounded-xl border border-gray-200 shadow-sm">
        <form action="{{ route('transactions.store') }}" method="POST" class="space-y-5">
          {{ csrfField() }}

          {{-- Tipo de Transacción --}}
          <div>
            <label for="type" class="block text-sm font-medium text-gray-700 mb-1">Tipo de Movimiento</label>
            <select
              id="type"
              name="type"
              required
              onchange="toggleTransactionFields()"
              class="w-full px-4 py-2 border rounded-lg text-sm focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition bg-white"
            >
              <option value="expense" {{ old('type') === 'expense' ? 'selected' : '' }}>Gasto (-)</option>
              <option value="income" {{ old('type') === 'income' ? 'selected' : '' }}>Ingreso (+)</option>
              <option value="transfer" {{ old('type') === 'transfer' ? 'selected' : '' }}>Transferencia entre Cuentas</option>
            </select>
          </div>

          {{-- Cuenta Origen --}}
          <div>
            <label for="accountId" class="block text-sm font-medium text-gray-700 mb-1">Cuenta Origen</label>
            <select
              id="accountId"
              name="accountId"
              required
              class="w-full px-4 py-2 border rounded-lg text-sm focus:ring-2 focus:ring-indigo-500 outline-none transition bg-white"
            >
              <option value="" disabled selected>Selecciona una cuenta</option>
              @each(acc in viewData.accounts)
                <option value="{{ acc.id }}" {{ old('accountId') == acc.id ? 'selected' : '' }}>
                  {{ acc.name }} (${{ Number(acc.initialBalance).toFixed(2) }})
                </option>
              @endeach
            </select>
          </div>

          {{-- Campo Dinámico: Cuenta Destino (Solo para Transferencias) --}}
          <div id="destinationAccountContainer" class="hidden">
            <label for="destinationAccountId" class="block text-sm font-medium text-gray-700 mb-1">Cuenta Destino</label>
            <select
              id="destinationAccountId"
              name="destinationAccountId"
              class="w-full px-4 py-2 border rounded-lg text-sm focus:ring-2 focus:ring-indigo-500 outline-none transition bg-white"
            >
              <option value="" disabled selected>Selecciona la cuenta destino</option>
              @each(acc in viewData.accounts)
                <option value="{{ acc.id }}" {{ old('destinationAccountId') == acc.id ? 'selected' : '' }}>
                  {{ acc.name }} (${{ Number(acc.initialBalance).toFixed(2) }})
                </option>
              @endeach
            </select>
          </div>

          {{-- Campo Dinámico: Categoría (Para Ingresos/Gastos) --}}
          <div id="categoryContainer">
            <label for="categoryId" class="block text-sm font-medium text-gray-700 mb-1">Categoría</label>
            <select
              id="categoryId"
              name="categoryId"
              class="w-full px-4 py-2 border rounded-lg text-sm focus:ring-2 focus:ring-indigo-500 outline-none transition bg-white"
            >
              <option value="" disabled selected>Selecciona una categoría</option>
              @each(cat in viewData.categories)
                <option value="{{ cat.id }}" {{ old('categoryId') == cat.id ? 'selected' : '' }}>
                  {{ cat.name }}
                </option>
              @endeach
            </select>
          </div>

          {{-- Monto --}}
          <div>
            <label for="amount" class="block text-sm font-medium text-gray-700 mb-1">Monto ($)</label>
            <input
              type="number"
              step="1"
              min="1"
              id="amount"
              name="amount"
              value="{{ old('amount') || '' }}"
              required
              class="w-full px-4 py-2 border rounded-lg text-sm focus:ring-2 focus:ring-indigo-500 outline-none transition"
              placeholder="000"
            >
          </div>

          {{-- Fecha --}}
          <div>
            <label for="transactionDate" class="block text-sm font-medium text-gray-700 mb-1">Fecha</label>
            <input
              type="date"
              id="transactionDate"
              name="transactionDate"
              value="{{ old('transactionDate') || new Date().toISOString().split('T')[0] }}"
              required
              class="w-full px-4 py-2 border rounded-lg text-sm focus:ring-2 focus:ring-indigo-500 outline-none transition"
            >
          </div>

          {{-- Descripción --}}
          <div>
            <label for="description" class="block text-sm font-medium text-gray-700 mb-1">Descripción (Opcional)</label>
            <input
              type="text"
              id="description"
              name="description"
              value="{{ old('description') || '' }}"
              class="w-full px-4 py-2 border rounded-lg text-sm focus:ring-2 focus:ring-indigo-500 outline-none transition"
              placeholder="Ej. Compras del supermercado, Pago de nómina"
            >
          </div>

          <div class="flex items-center justify-end gap-3 pt-4 border-t border-gray-100">
            <a href="{{ route('transactions.index') }}" class="px-4 py-2 rounded-lg text-sm font-medium text-gray-700 hover:bg-gray-100 transition">
              Cancelar
            </a>
            <button
              type="submit"
              class="bg-indigo-600 text-white font-medium px-5 py-2 rounded-lg hover:bg-indigo-700 transition duration-150 shadow-sm text-sm"
            >
              Registrar Movimiento
            </button>
          </div>
        </form>
      </div>
    </div>

    {{-- Script para alternar visibilidad de campos condicionales --}}
    <script>
      function toggleTransactionFields() {
        const type = document.getElementById('type').value;
        const destContainer = document.getElementById('destinationAccountContainer');

        if (type === 'transfer') {
          destContainer.classList.remove('hidden');
        } else {
          destContainer.classList.add('hidden');
        }
      }

      // Ejecutar al cargar la página para mantener selección si hubo error de validación
      document.addEventListener('DOMContentLoaded', toggleTransactionFields);
    </script>
  @end
@end
